#!/usr/bin/env python3
"""SayAndShape command line: set up the engine, connect projects, run the worker.

    bin/sayandshape init                 create config and working directories
    bin/sayandshape doctor               check prerequisites, configuration and wiring
    bin/sayandshape agent [options]      show the AI agents found, choose one, store or remove an API key,
                                         switch the agent sandbox (--sandbox on|off)
    bin/sayandshape add PATH [options]   register a project and wire it to the engine
    bin/sayandshape remove ID            unregister a project and remove the wiring
    bin/sayandshape list                 registered projects
    bin/sayandshape passwd               set the login password
    bin/sayandshape language [en|de]     show or set the interface language (panel, login, setup page)
    bin/sayandshape check ID --url URL   test a running site over HTTP
    bin/sayandshape daemon start|stop|restart|status
    bin/sayandshape service              print a systemd unit (Linux) or launchd plist (macOS)
    bin/sayandshape update               pull the latest engine version and restart the worker

Standard library only. Everything is idempotent: running a command twice is safe.
"""
import argparse
import fcntl
import getpass
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

ENGINE = Path(__file__).resolve().parents[1]
CONFIG = ENGINE / 'config/apps.json'
AUTH = ENGINE / 'config/auth.json'
PIDFILE = ENGINE / 'jobs/.daemon.pid'
LOG = ENGINE / 'daemon.log'
STUB = 'sayandshape-router.php'
MARK = 'Generated by SayAndShape (bin/sayandshape add)'
BEGIN, END = '# BEGIN SayAndShape', '# END SayAndShape'
SLUG = r'[a-z0-9][a-z0-9-]{0,39}'
APP_ID = r'[a-z0-9][a-z0-9_-]{0,39}'
DATA_NAMES = {'media', 'uploads', 'upload', 'content', 'import', 'images', 'img', 'videos', 'photos', 'files', 'storage', 'cache'}
SKIP_NAMES = {'.git', 'node_modules', 'vendor'}
DEFAULT_ALLOWED = 'Behavior, appearance, layout, colors, animations, texts and content of the application'
DEFAULT_BLOCKED = ['.env', 'config.php', '.htaccess', STUB]
# Interface language of the panel, login, setup page and worker messages (changed on /sayandshape/setup/).
LANGUAGES = {'en': 'English', 'de': 'Deutsch'}
AGENT_DEFAULTS = {'engine': 'claude', 'claude_model': 'claude-opus-5-5', 'codex_model': 'gpt-6.1-terra', 'effort': 'medium',
                  'sandbox': True}
# Reads outside the working copy are blocked from this Claude Code version on (permissions.blockReadsOutsideWorkingDirectories).
CLAUDE_SANDBOX_VERSION = (2, 1, 257)
# API keys live outside config/ (which is shared with the web server's group) and are readable by the worker user only.
KEYS = ENGINE / '.agent-keys.json'
AGENTS = {
    'claude': {'label': 'Claude Code', 'provider': 'Anthropic', 'env': 'ANTHROPIC_API_KEY', 'prefix': 'sk-ant-',
               'status': ['claude', 'auth', 'status'], 'login': 'claude auth login',
               'install': 'curl -fsSL https://claude.ai/install.sh | bash'},
    'codex': {'label': 'Codex', 'provider': 'OpenAI', 'env': 'CODEX_API_KEY', 'prefix': 'sk-',
              'status': ['codex', 'login', 'status'], 'login': 'codex login',
              'install': 'npm install -g @openai/codex'},
}


class Problem(Exception):
    pass


def say(text=''):
    print(text, flush=True)


# ── Configuration ───────────────────────────────────────────────────────

def load_config():
    if not CONFIG.exists():
        raise Problem(f'{CONFIG} is missing. Run this first: bin/sayandshape init')
    try:
        data = json.loads(CONFIG.read_text())
    except ValueError as exc:
        raise Problem(f'{CONFIG} is not valid JSON: {exc}')
    if not isinstance(data, dict) or not isinstance(data.get('apps'), dict):
        raise Problem(f'{CONFIG}: section "apps" is missing')
    return data


def write_file(path, text, mode=None):
    """Atomic write that keeps the permissions of an existing file (the web server may need group access)."""
    path = Path(path)
    if mode is None:
        mode = (path.stat().st_mode & 0o777) if path.exists() else 0o664
    fd, tmp = tempfile.mkstemp(prefix='.' + path.name, dir=path.parent)
    try:
        with os.fdopen(fd, 'w') as out:
            out.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        Path(tmp).unlink(missing_ok=True)


def save_config(data):
    write_file(CONFIG, json.dumps(data, ensure_ascii=False, indent=2) + '\n')


def slugify(name):
    text = name.strip().lower()
    for src, dst in (('ä', 'ae'), ('ö', 'oe'), ('ü', 'ue'), ('ß', 'ss')):
        text = text.replace(src, dst)
    return re.sub(r'[^a-z0-9]+', '-', text).strip('-')[:40].strip('-')


def split_list(value):
    return [item.strip().strip('/') for item in (value or '').split(',') if item.strip().strip('/')]


def mount_of(app):
    return urllib.parse.urlparse(app.get('app_url') or '').path.rstrip('/')


# ── Wiring a project ────────────────────────────────────────────────────

def stub_text(app_id):
    return f"""<?php
// {MARK}. Do not edit: changes are overwritten. To change the setup, run bin/sayandshape add again.
// Usage with PHP's built-in server: php -S localhost:8080 -t . {STUB}
const SAYANDSHAPE_APP_ID = {json.dumps(app_id)};
const SAYANDSHAPE_ENGINE_DIR = {json.dumps(str(ENGINE))};
return require SAYANDSHAPE_ENGINE_DIR . '/router/router.php';
"""


def htaccess_block(app, url_given):
    lines = [BEGIN, '# Sends requests to SayAndShape. Managed by bin/sayandshape; keep this block at the top of the file.',
             '<IfModule mod_rewrite.c>', 'RewriteEngine On']
    if url_given:
        lines.append(f'RewriteBase {mount_of(app)}/')
    if app.get('serve') == 'prefix':
        lines += [r'RewriteRule ^(w|sayandshape)(/.*)?$ ' + STUB + ' [L,QSA]', 'RewriteRule ^$ ' + STUB + ' [L,QSA]']
    else:
        lines += [r'RewriteRule ^sayandshape-router\.php$ - [L]', 'RewriteRule ^ ' + STUB + ' [L]']
    return '\n'.join(lines + ['</IfModule>', END]) + '\n'


def strip_block(text):
    return re.sub(re.escape(BEGIN) + r'.*?' + re.escape(END) + r'\n?', '', text, flags=re.S)


def fpm_socket():
    for pattern in ('/run/php/php*-fpm.sock', '/var/run/php/php*-fpm.sock', '/run/php-fpm/*.sock', '/var/run/php-fpm/*.sock'):
        found = sorted(Path('/').glob(pattern.lstrip('/')))
        if found:
            return 'unix:' + str(found[-1])
    return '127.0.0.1:9000'


def nginx_block(app_id, app):
    mount, base = mount_of(app), app['base_dir']
    body = f"""        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME {base}/{STUB};
        fastcgi_param SCRIPT_NAME {mount}/{STUB};
        fastcgi_pass {fpm_socket()};   # adjust to this server's PHP-FPM socket
"""
    if app.get('serve') == 'prefix':
        locations = f"""    location ~ ^{re.escape(mount)}/(w|sayandshape)(/|$) {{
{body}    }}
    location = {mount}/ {{
{body}    }}
"""
    else:
        locations = f"""    location ^~ {mount}/ {{
{body}    }}
"""
    return (f'    # SayAndShape project "{app_id}": place inside the server {{ }} block of this site, before other locations.\n'
            + locations)


def inspect(base):
    """Entry file, size and the folders worth sharing instead of copying into every variant."""
    index = next((name for name in ('index.php', 'index.html', 'index.htm') if (base / name).is_file()), None)
    total_files = total_bytes = 0
    suggested = []
    for entry in sorted(base.iterdir()):
        if entry.is_symlink() or entry.name in SKIP_NAMES and entry.is_dir():
            continue
        if entry.is_file():
            total_files += 1
            total_bytes += entry.stat().st_size
            continue
        if not entry.is_dir():
            continue
        files = size = 0
        for root, dirs, names in os.walk(entry):
            for name in names:
                path = Path(root) / name
                if not path.is_symlink():
                    files += 1
                    size += path.stat().st_size
            if files > 200000:
                break
        total_files += files
        total_bytes += size
        if not entry.name.startswith('.') and (size > 10 * 1024 * 1024 or entry.name.lower() in DATA_NAMES):
            suggested.append(entry.name)
    return dict(index=index, files=total_files, bytes=total_bytes, suggested_shared=suggested)


def cmd_add(args):
    base = Path(args.path).expanduser().resolve()
    if not base.is_dir():
        raise Problem(f'Folder not found: {base}')
    if base == Path('/') or ENGINE == base or ENGINE in base.parents or base in ENGINE.parents:
        raise Problem('This folder cannot be used as a project (engine and project must be in separate folders)')
    config = load_config()
    apps = config['apps']
    existing_id = next((key for key, app in apps.items() if isinstance(app, dict) and app.get('base_dir') == str(base)), None)
    app_id = args.id or existing_id or slugify(base.name)
    if not re.fullmatch(APP_ID, app_id or ''):
        raise Problem('ID: lowercase letters, digits, - and _ only (max. 40). Set it with --id.')
    if app_id in apps and apps[app_id].get('base_dir') not in (None, str(base)) and not args.force:
        raise Problem(f'The ID "{app_id}" already belongs to {apps[app_id].get("base_dir")}. Choose another --id or use --force.')
    new = app_id not in apps
    app = dict(apps.get(app_id) or {})
    facts = inspect(base)

    app['name'] = args.name or app.get('name') or base.name
    app['base_dir'] = str(base)
    app.setdefault('clone_dir', str(ENGINE / 'clones' / app_id))
    app['serve_base'] = '/w/'
    public = args.public or app.get('public_workspace') or 'main'
    if not re.fullmatch(SLUG, public) or public in {'sayandshape', 'api', 'widget', 'admin', 'u', 'w'}:
        raise Problem('Public variant: invalid ID')
    app['public_workspace'] = public
    if args.url is not None:
        if args.url and not re.match(r'https?://[^/\s]+', args.url):
            raise Problem('--url must start with http:// or https://')
        app['app_url'] = args.url.rstrip('/')
    app.setdefault('app_url', '')
    app['serve'] = args.serve or app.get('serve') or 'root'
    if args.shared is not None:
        app['shared_dirs'] = split_list(args.shared)
    elif 'shared_dirs' not in app:
        app['shared_dirs'] = facts['suggested_shared']
    if any('..' in item.split('/') for item in app['shared_dirs']):
        raise Problem('--shared: relative paths without ".." only')
    app['allowed_changes'] = args.allowed or app.get('allowed_changes') or DEFAULT_ALLOWED
    if args.blocked is not None:
        app['extra_blocked_files'] = split_list(args.blocked)
    app.setdefault('extra_blocked_files', list(DEFAULT_BLOCKED))
    app.setdefault('extra_blocked_patterns', [])
    app.setdefault('max_files_per_change', 20)
    app.setdefault('auto_commit_host_changes', True)
    auth = dict(app.get('auth') or {})
    if args.auth:
        auth['mode'] = args.auth
    auth.setdefault('mode', 'engine')
    if args.session_name is not None:
        if not re.fullmatch(r'[A-Za-z0-9_-]{1,64}', args.session_name):
            raise Problem('--session-name: letters, digits, _ and - only')
        auth['session_name'] = args.session_name
    if args.session_key is not None:
        auth['session_key'] = args.session_key
    if args.engine_admin:
        auth['engine_admin'] = True
    app['auth'] = auth if auth['mode'] == 'host' else {'mode': 'engine'}

    server = args.server or app.get('server') or 'auto'
    if server == 'auto':
        server = 'apache' if (base / '.htaccess').exists() else 'php'
    app['server'] = server

    stub = base / STUB
    if stub.exists() and MARK not in stub.read_text(errors='replace') and not args.force:
        raise Problem(f'{stub} already exists and was not written by bin/sayandshape. '
                      'With --force it is backed up to sayandshape-router.php.bak and replaced.')
    htaccess = base / '.htaccess'
    warnings = []
    if server == 'apache' and htaccess.exists() and re.search(r'^\s*Rewrite(Rule|Cond)\b', strip_block(htaccess.read_text(errors='replace')), re.M | re.I):
        warnings.append('.htaccess has its own rewrite rules. They no longer apply to requests that SayAndShape serves'
                        + (' (with --serve root: all pages).' if app['serve'] == 'root' else '.'))
    if not facts['index']:
        warnings.append('No index.php/index.html found in the project folder; the start page will return 404.')

    if args.dry_run:
        say(json.dumps({app_id: app}, ensure_ascii=False, indent=2))
        say('\n(--dry-run: nothing written)')
        return 0

    if stub.exists() and MARK not in stub.read_text(errors='replace'):
        shutil.copy2(stub, base / (STUB + '.bak'))
    write_file(stub, stub_text(app_id), 0o644)
    if server == 'apache':
        current = htaccess.read_text(errors='replace') if htaccess.exists() else ''
        write_file(htaccess, htaccess_block(app, bool(app['app_url'])) + strip_block(current), None if htaccess.exists() else 0o644)
    elif htaccess.exists() and BEGIN in htaccess.read_text(errors='replace'):
        write_file(htaccess, strip_block(htaccess.read_text(errors='replace')))
    nginx_file = ENGINE / 'config' / f'nginx-{app_id}.conf'
    if server == 'nginx':
        write_file(nginx_file, nginx_block(app_id, app), 0o644)
    apps[app_id] = app
    config.setdefault('max_parallel_jobs', 3)
    config.setdefault('language', 'en')
    config.setdefault('agent', dict(AGENT_DEFAULTS))
    save_config(config)

    site = app['app_url'] or 'http://localhost:8080'
    say(f'Project "{app_id}" {"created" if new else "updated"}: {base}')
    say(f'  Files: {facts["files"]} · {facts["bytes"] / 1048576:.1f} MB · Start file: {facts["index"] or "none"}')
    say(f'  Shared folders (not copied per variant): {", ".join(app["shared_dirs"]) or "none"}')
    say(f'  Serving: {"public variant at the normal address" if app["serve"] == "root" else "variants only under /w/<variant>/"}')
    login = 'own login page' if app['auth']['mode'] == 'engine' else "the app's admin session"
    say(f'  Login: {login}')
    say(f'  Written: {stub}')
    if server == 'apache':
        say(f'  Written: {htaccess} (block "{BEGIN}" at the top of the file; needs mod_rewrite and AllowOverride FileInfo)')
    elif server == 'nginx':
        say(f'  Written: {nginx_file}')
        say('  Add this block to the site\'s server block and reload Nginx (nginx -t && nginx -s reload):\n')
        say(nginx_block(app_id, app))
    else:
        say(f'  Run locally: php -S localhost:8080 -t {base} {stub}')
    for warning in warnings:
        say(f'  Note: {warning}')
    say('\nNext steps:')
    step = 1
    if app['auth']['mode'] == 'engine' and not AUTH.exists():
        say(f'  {step}. Set a password:   {ENGINE}/bin/sayandshape passwd --generate'); step += 1
    if not daemon_running():
        say(f'  {step}. Start the worker: {ENGINE}/bin/sayandshape daemon start'); step += 1
    say(f'  {step}. Check:            {ENGINE}/bin/sayandshape check {app_id} --url {site}'); step += 1
    say(f'  {step}. Log in:           {site}/sayandshape/login/')
    return 0


def cmd_remove(args):
    config = load_config()
    app = config['apps'].get(args.id)
    if not isinstance(app, dict):
        raise Problem(f'Project "{args.id}" is not registered')
    base = Path(app.get('base_dir') or '')
    stub = base / STUB
    if stub.is_file() and MARK in stub.read_text(errors='replace'):
        stub.unlink()
        say(f'Removed: {stub}')
    htaccess = base / '.htaccess'
    if htaccess.is_file() and BEGIN in htaccess.read_text(errors='replace'):
        rest = strip_block(htaccess.read_text(errors='replace'))
        if rest.strip():
            write_file(htaccess, rest)
        else:
            htaccess.unlink()
        say(f'SayAndShape block removed: {htaccess}')
    (ENGINE / 'config' / f'nginx-{args.id}.conf').unlink(missing_ok=True)
    clones = Path(app.get('clone_dir') or '')
    if args.purge and clones.is_dir() and ENGINE in clones.resolve().parents:
        shutil.rmtree(clones)
        say(f'Variants deleted: {clones}')
    elif clones.is_dir():
        say(f'Variants kept: {clones} (delete them with --purge)')
    del config['apps'][args.id]
    save_config(config)
    say(f'Project "{args.id}" removed. The project\'s files were not changed.')
    if app.get('server') == 'nginx':
        say('Remove the project\'s location block from the Nginx configuration and reload Nginx.')
    return 0


def cmd_list(args):
    apps = load_config()['apps']
    if args.json:
        say(json.dumps(apps, ensure_ascii=False, indent=2))
        return 0
    if not apps:
        say('No project set up yet. Add one: bin/sayandshape add /path/to/project')
    for app_id, app in apps.items():
        clones = Path(app.get('clone_dir') or '')
        variants = sum(1 for item in clones.iterdir() if (item / '.git').is_dir()) if clones.is_dir() else 0
        say(f'{app_id}\t{app.get("base_dir", "")}\t{app.get("app_url") or "-"}\t{app.get("serve", "root")}\t'
            f'{(app.get("auth") or {}).get("mode", "engine")}\t{variants} variant(s)')
    return 0


# ── Setup and checks ────────────────────────────────────────────────────

def cmd_init(args):
    for name in ('config', 'jobs', 'clones'):
        (ENGINE / name).mkdir(exist_ok=True)
    created = not CONFIG.exists()
    if created:
        write_file(CONFIG, json.dumps({'max_parallel_jobs': 3, 'language': 'en', 'apps': {}, 'agent': dict(AGENT_DEFAULTS)}, indent=2) + '\n')
        say(f'Configuration created: {CONFIG}')
    else:
        load_config()
        say(f'Configuration found: {CONFIG}')
    say()
    # A new installation asks which agent to use (in a terminal) or takes the one that is installed.
    agent_setup(first_run=created, interactive=created and terminal())
    say()
    say(f'SayAndShape {version()} ready in {ENGINE}')
    say('Next: bin/sayandshape doctor · bin/sayandshape add /path/to/project')
    return 0


def version():
    try:
        return (ENGINE / 'VERSION').read_text().strip()
    except OSError:
        return 'unknown'


def tool_version(command, pattern):
    try:
        out = subprocess.run(command, capture_output=True, text=True, timeout=20)
        match = re.search(pattern, out.stdout + out.stderr)
        return match.group(1) if match else None
    except (OSError, subprocess.SubprocessError):
        return None


def daemon_running():
    lock = ENGINE / 'jobs/.worker.lock'
    if not lock.exists():
        return False
    try:
        with open(lock) as handle:
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                return True
            fcntl.flock(handle, fcntl.LOCK_UN)
    except OSError:
        pass
    return False


def cmd_doctor(args):
    results = []
    def report(level, text):
        results.append(level)
        say(f'  [{level}] {text}')

    say(f'SayAndShape {version()} in {ENGINE}\n\nPrerequisites')
    php = tool_version(['php', '-r', 'echo PHP_VERSION;'], r'(\d+\.\d+\.\d+)')
    if not php:
        report('FAIL', 'php not found (PHP 8.1 or newer is required)')
    elif tuple(map(int, php.split('.')[:2])) < (8, 1):
        report('FAIL', f'PHP {php} is too old (8.1 or newer is required)')
    else:
        report('OK', f'PHP {php}')
    report('OK' if sys.version_info >= (3, 9) else 'FAIL', f'Python {sys.version.split()[0]} (3.9 or newer is required)')
    for tool in ('git', 'bash', 'jq'):
        report('OK' if shutil.which(tool) else 'FAIL', f'{tool} {"found" if shutil.which(tool) else "not found"}')

    config = None
    try:
        config = load_config()
        report('OK', f'Configuration readable ({len(config["apps"])} project(s))')
        language = config.get('language', 'en')
        report('OK' if language in LANGUAGES else 'WARN', f'Interface language: {LANGUAGES[language]} (change: bin/sayandshape language en|de)'
               if language in LANGUAGES else f'Interface language "{language}" is unknown; English is used (en or de)')
    except Problem as exc:
        report('FAIL', str(exc))
    binary = agent_settings(config or {})['engine']
    probe = probe_agent(binary)
    try:
        keys = load_keys()
    except Problem as exc:
        keys = {}
        report('FAIL', str(exc))
    if not probe['path']:
        report('FAIL', f'AI agent "{binary}" not in PATH. Install it ({AGENTS[binary]["install"]}) '
                       'or choose the other one: bin/sayandshape agent')
    elif binary in keys:
        report('OK', f'AI agent "{binary}" found ({probe["path"]}); API key stored')
        if KEYS.stat().st_mode & 0o077:
            report('WARN', f'{KEYS} is readable by other users (chmod 600 {KEYS})')
    elif probe['logged_in'] is False:
        report('WARN', f'AI agent "{binary}" found ({probe["path"]}), but not signed in for "{getpass.getuser()}": '
                       f'run "{AGENTS[binary]["login"]}" as the worker user or store an API key (bin/sayandshape agent)')
    else:
        report('OK', f'AI agent "{binary}" found ({probe["path"]}); '
                     + ('signed in' if probe['logged_in'] else 'sign-in cannot be checked'))
    if agent_settings(config or {})['sandbox'] is False:
        report('WARN', 'Agent sandbox is off: the AI agent can read and change everything the worker user can. '
                       'Keep it off only inside a container or VM that holds nothing else (bin/sayandshape agent --sandbox on)')
    elif probe['path']:
        missing = [tool for tool in ('bwrap', 'socat') if not shutil.which(tool)] if binary == 'claude' and sys.platform.startswith('linux') else []
        old = binary == 'claude' and probe['version'] and tuple(map(int, probe['version'].split('.'))) < CLAUDE_SANDBOX_VERSION
        if missing:
            report('FAIL', f'Agent sandbox: {" and ".join(missing)} not found, so change requests will fail. Install bubblewrap and socat '
                           '(apt install bubblewrap socat), or, inside a container or VM only: bin/sayandshape agent --sandbox off')
        elif old:
            report('WARN', f'Agent sandbox: Claude Code {probe["version"]} does not block reads outside the working copy yet; '
                           f'update it to {".".join(map(str, CLAUDE_SANDBOX_VERSION))} or newer')
        else:
            report('OK', 'Agent sandbox on: the AI agent writes only inside the working copy of a change')
    for name in ('jobs', 'clones', 'config'):
        path = ENGINE / name
        report('OK' if path.is_dir() and os.access(path, os.W_OK) else 'FAIL', f'{name}/ {"writable" if os.access(path, os.W_OK) else "missing or not writable"}')
    report('OK' if daemon_running() else 'WARN', 'Worker running' if daemon_running() else 'Worker not running (bin/sayandshape daemon start)')

    if config:
        apps = {key: app for key, app in config['apps'].items() if isinstance(app, dict)}
        if any((app.get('auth') or {}).get('mode', 'engine') == 'engine' for app in apps.values()) or not apps:
            report('OK' if AUTH.exists() else 'WARN', 'Login password set' if AUTH.exists() else 'No login password set (bin/sayandshape passwd)')
        for app_id, app in apps.items():
            say(f'\nProject {app_id}')
            base = Path(app.get('base_dir') or '/nonexistent')
            if not base.is_dir():
                report('FAIL', f'Project folder missing: {base}')
                continue
            report('OK', f'Project folder {base}')
            if ENGINE in base.parents or ENGINE == base or base in ENGINE.parents:
                report('FAIL', 'Engine and project are nested; the engine must be outside the project folder')
            stub = base / STUB
            text = stub.read_text(errors='replace') if stub.is_file() else ''
            if not text:
                report('FAIL', f'{STUB} missing in the project (bin/sayandshape add {base} --id {app_id})')
            elif MARK not in text:
                report('WARN', f'{STUB} is a custom version; it is not maintained by bin/sayandshape')
            elif json.dumps(str(ENGINE)) not in text or json.dumps(app_id) not in text:
                report('FAIL', f'{STUB} points to another engine or ID (bin/sayandshape add {base} --id {app_id})')
            else:
                report('OK', f'{STUB} points to this engine')
            server = app.get('server')
            if server == 'apache':
                htaccess = base / '.htaccess'
                wired = htaccess.is_file() and BEGIN in htaccess.read_text(errors='replace')
                report('OK' if wired else 'FAIL', '.htaccess contains the SayAndShape block' if wired else '.htaccess without SayAndShape block')
            elif server == 'nginx':
                report('WARN', f'Nginx: the block from config/nginx-{app_id}.conf must be in the server configuration (cannot be checked)')
            if (app.get('auth') or {}).get('mode') == 'host':
                report('OK', f'Login via the app\'s session (key {(app["auth"]).get("session_key", "admin_logged_in")})')
            if app.get('app_url'):
                say(f'  Check the live site: bin/sayandshape check {app_id} --url {app["app_url"]}')
    fails, warns = results.count('FAIL'), results.count('WARN')
    say(f'\n{"All checks passed" if not fails and not warns else f"{fails} failed, {warns} warning(s)"}')
    return 1 if fails else 0


def fetch(url, cookie=None):
    request = urllib.request.Request(url, headers={'Cookie': cookie} if cookie else {})
    opener = urllib.request.build_opener(NoRedirect)
    try:
        with opener.open(request, timeout=15) as response:
            return response.status, response.read(200000), dict(response.headers)
    except urllib.error.HTTPError as error:
        return error.code, error.read(200000), dict(error.headers)
    except (urllib.error.URLError, OSError) as error:
        raise Problem(f'{url} not reachable: {getattr(error, "reason", error)}')


class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def cmd_check(args):
    config = load_config()
    app = config['apps'].get(args.id)
    if not isinstance(app, dict):
        raise Problem(f'Project "{args.id}" is not registered')
    site = (args.url or app.get('app_url') or '').rstrip('/')
    if not site:
        raise Problem('Address missing: pass --url http://…')
    public = app.get('public_workspace') or 'main'
    failed = 0
    def expect(label, ok, detail=''):
        nonlocal failed
        failed += 0 if ok else 1
        say(f'  [{"OK" if ok else "FAIL"}] {label}{" – " + detail if detail and not ok else ""}')

    say(f'Checking {site}')
    status, body, _ = fetch(site + '/sayandshape/api/session.php')
    try:
        data = json.loads(body)
    except ValueError:
        data = None
    expect('API reachable (/sayandshape/api/session.php)', status == 200 and isinstance(data, dict) and data.get('success') is True,
           f'HTTP {status}; the web server does not pass /sayandshape/… to {STUB}')
    status, body, _ = fetch(site + '/sayandshape/widget/sayandshape-widget.js')
    expect('Panel files reachable', status == 200 and b'SayAndShape' in body, f'HTTP {status}')
    status, body, _ = fetch(site + '/sayandshape/login/')
    expect('Login page reachable', status == 200 and b'SayAndShape' in body, f'HTTP {status}')
    status, body, headers = fetch(site + '/')
    if app.get('serve') == 'prefix':
        expect('Start page redirects to the public variant', status == 302 and f'/w/{public}/' in headers.get('Location', ''), f'HTTP {status}')
    else:
        expect('Start page is served', status == 200, f'HTTP {status}')
        status, body, _ = fetch(site + '/', cookie='sayandshape_ui=1')
        html = b'</body>' in body.lower()
        expect('Panel is inserted for logged-in users', b'sayandshape-widget.js' in body,
               'no </body> in the start page' if not html else 'script tag missing')
    status, _, _ = fetch(site + f'/w/{public}/')
    expect(f'Variant /w/{public}/ reachable', status == 200, f'HTTP {status}')
    status, _, _ = fetch(site + f'/w/{public}/.git/config')
    expect('Repository data is not reachable', status in (403, 404), f'HTTP {status}')
    status, _, _ = fetch(site + '/' + STUB)
    expect('Router file is not directly reachable', status in (403, 404), f'HTTP {status}')
    say('All checks passed' if not failed else f'{failed} check(s) failed')
    return 1 if failed else 0


def cmd_language(args):
    config = load_config()
    current = config.get('language') if config.get('language') in LANGUAGES else 'en'
    if args.language and args.language != config.get('language'):
        config['language'] = args.language
        save_config(config)
        current = args.language
    say(f'Interface language: {LANGUAGES[current]} ({current}). Applies to the panel, login, setup page and worker messages.')
    if not args.language:
        say('Change: bin/sayandshape language en|de, or on /sayandshape/setup/ → Settings')
    return 0


def cmd_passwd(args):
    if args.generate:
        password = secrets.token_urlsafe(12)
    elif args.stdin:
        password = sys.stdin.readline().rstrip('\n')
    elif os.environ.get('SAYANDSHAPE_PASSWORD'):
        password = os.environ['SAYANDSHAPE_PASSWORD']
    else:
        password = getpass.getpass('New password: ')
        if getpass.getpass('Repeat: ') != password:
            raise Problem('The entries do not match')
    if len(password) < 8:
        raise Problem('The password must have at least 8 characters')
    result = subprocess.run(['php', '-r', 'echo password_hash(stream_get_contents(STDIN), PASSWORD_DEFAULT);'],
                            input=password, capture_output=True, text=True)
    if result.returncode or not result.stdout.startswith('$'):
        raise Problem('Could not hash the password (is php available?)')
    (ENGINE / 'config').mkdir(exist_ok=True)
    write_file(AUTH, json.dumps({'password_hash': result.stdout}) + '\n', (AUTH.stat().st_mode & 0o777) if AUTH.exists() else 0o640)
    say(f'Password saved in {AUTH} (hashed).')
    if args.generate:
        say(f'Password: {password}')
        say('It is shown only now. Change: bin/sayandshape passwd')
    return 0


# ── AI agent ────────────────────────────────────────────────────────────

def terminal():
    return sys.stdin.isatty() and sys.stdout.isatty()


def agent_settings(config):
    saved = config.get('agent') if isinstance(config.get('agent'), dict) else {}
    agent = dict(AGENT_DEFAULTS, **saved)
    if agent.get('engine') not in AGENTS:
        agent['engine'] = AGENT_DEFAULTS['engine']
    agent['sandbox'] = agent.get('sandbox') is not False      # only an explicit false switches it off
    return agent


def load_keys():
    try:
        data = json.loads(KEYS.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as exc:
        raise Problem(f'{KEYS} is not readable: {exc}')
    if not isinstance(data, dict):
        return {}
    return {name: key for name, key in data.items() if name in AGENTS and isinstance(key, str) and key}


def save_keys(keys):
    if keys:
        write_file(KEYS, json.dumps(keys, indent=2) + '\n', 0o600)
    else:
        KEYS.unlink(missing_ok=True)


def probe_agent(name):
    """Where the CLI is, its version and whether the current user is signed in (None: could not be determined)."""
    path = shutil.which(name)
    probe = {'path': path, 'version': None, 'logged_in': None}
    if not path:
        return probe
    probe['version'] = tool_version([name, '--version'], r'(\d+\.\d+\.\d+)')
    try:
        out = subprocess.run(AGENTS[name]['status'], capture_output=True, text=True, timeout=20, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.SubprocessError):
        return probe
    if name == 'claude':
        try:
            probe['logged_in'] = bool(json.loads(out.stdout)['loggedIn'])
        except (ValueError, KeyError, TypeError):
            pass    # an older CLI without "auth status"
    elif re.search(r'not logged in', out.stdout + out.stderr, re.I):
        probe['logged_in'] = False
    elif out.returncode == 0 and re.search(r'logged in', out.stdout + out.stderr, re.I):
        probe['logged_in'] = True
    return probe


def agent_line(name, probe, keys):
    if not probe['path']:
        return f'{name}: not installed (install: {AGENTS[name]["install"]})'
    login = {True: 'signed in', False: 'not signed in', None: 'sign-in cannot be checked'}[probe['logged_in']]
    return f'{name} {probe["version"] or ""} ({probe["path"]}): {login}'.replace('  ', ' ') + (', API key stored' if name in keys else '')


def choose(question, options, default):
    """Numbered question on the terminal; returns the index of the chosen option."""
    say(question)
    for number, text in enumerate(options, 1):
        say(f'  {number}) {text}')
    while True:
        try:
            answer = input(f'Choice [{default + 1}]: ').strip()
        except EOFError:
            raise Problem('Cancelled')
        if not answer:
            return default
        if answer.isdigit() and 1 <= int(answer) <= len(options):
            return int(answer) - 1
        say(f'Please enter a number from 1 to {len(options)}.')


def check_key(name, key):
    if not re.fullmatch(r'[\x21-\x7e]{16,512}', key):
        raise Problem('This is not a valid API key (16 to 512 characters, no spaces)')
    if not key.startswith(AGENTS[name]['prefix']):
        say(f'Note: {AGENTS[name]["provider"]} API keys usually start with "{AGENTS[name]["prefix"]}".')
    return key


def agent_setup(engine=None, key=None, login=False, first_run=False, interactive=False, sandbox=None):
    """Show the agents found and apply a choice. Returns (settings, keys, probes)."""
    config = load_config()
    agent = agent_settings(config)
    keys = load_keys()
    probes = {name: probe_agent(name) for name in AGENTS}
    installed = [name for name in AGENTS if probes[name]['path']]
    say('AI agents on this machine')
    for name in AGENTS:
        say('  ' + agent_line(name, probes[name], keys))

    if interactive:
        names = list(AGENTS)
        current = agent['engine'] if agent['engine'] in installed or not installed else installed[0]
        say()
        engine = names[choose('Which agent should carry out the changes?',
                              [f'{name} ({AGENTS[name]["label"]})' + ('' if name in installed else ', not installed yet') for name in names],
                              names.index(current))]
        say()
        with_key = choose(f'How does {engine} sign in?',
                          [f'with the CLI\'s own sign-in ({AGENTS[engine]["login"]}), e.g. a subscription',
                           f'with an {AGENTS[engine]["provider"]} API key, stored for SayAndShape only'],
                          1 if engine in keys or probes[engine]['logged_in'] is False else 0)
        if with_key:
            kept = ' (leave empty to keep the stored key)' if engine in keys else ''
            key = getpass.getpass(f'API key{kept}, input is hidden: ').strip() or None
            if not key and engine not in keys:
                raise Problem('No API key entered; nothing changed')
        else:
            login = True
        say()
    elif first_run and not engine and installed and agent['engine'] not in installed:
        engine = installed[0]

    engine = engine or agent['engine']
    if key:
        keys[engine] = check_key(engine, key)
    elif login:
        keys.pop(engine, None)
    if key or login:
        save_keys(keys)
    if sandbox is None:
        sandbox = agent['sandbox'] is not False
    if engine != agent['engine'] or sandbox != agent['sandbox'] or not isinstance(config.get('agent'), dict):
        agent['engine'], agent['sandbox'] = engine, sandbox
        config['agent'] = agent
        save_config(config)

    info, probe = AGENTS[engine], probes[engine]
    say(f'Using: {engine} ({agent[engine + "_model"]}), '
        + (f'API key in {KEYS}' if engine in keys else 'the CLI\'s own sign-in')
        + (', sandbox on' if agent['sandbox'] else ', sandbox OFF'))
    if not agent['sandbox']:
        say('  Warning: without the sandbox the agent can read and change everything the worker user can. '
            'Keep it off only inside a container or VM that holds nothing else.')
    if not probe['path']:
        say(f'  Warning: {engine} is not installed. Install it: {info["install"]}')
    elif engine not in keys and probe['logged_in'] is False:
        say(f'  Warning: {engine} is not signed in. Run "{info["login"]}" as the worker user '
            'or store an API key: bin/sayandshape agent --api-key-stdin')
    if not interactive:
        say('  Change: bin/sayandshape agent --engine claude|codex [--api-key-stdin | --login] [--sandbox on|off]')
    return agent, keys, probes


def cmd_agent(args):
    key = None
    if args.api_key_stdin:
        key = sys.stdin.readline().strip()
        if not key:
            raise Problem('No API key on standard input')
    changing = bool(args.engine or key or args.login or args.sandbox)
    agent, keys, probes = agent_setup(args.engine, key, args.login, interactive=not changing and not args.test and terminal(),
                                      sandbox=None if not args.sandbox else args.sandbox == 'on')
    if not args.test:
        return 0
    engine = agent['engine']
    if not probes[engine]['path']:
        raise Problem(f'{engine} is not installed')
    prompt, model = 'Reply with OK only', agent[engine + '_model']
    command = (['codex', 'exec', '-s', 'read-only', '--skip-git-repo-check', '-m', model, prompt] if engine == 'codex'
               else ['claude', '-p', '--model', model, prompt])
    env = dict(os.environ, **({AGENTS[engine]['env']: keys[engine]} if engine in keys else {}))
    say(f'\nTest call to {engine} ({model}); this uses a few tokens …')
    with tempfile.TemporaryDirectory(prefix='sayandshape-agent-test-') as folder:
        try:
            result = subprocess.run(command, cwd=folder, env=env, capture_output=True, text=True, timeout=180, stdin=subprocess.DEVNULL)
        except subprocess.TimeoutExpired:
            raise Problem(f'{engine} did not answer within 180 seconds')
    if result.returncode:
        detail = (result.stderr.strip() or result.stdout.strip()).splitlines()[-3:]
        raise Problem(f'{engine} reported an error (check sign-in, API key or model):\n  ' + '\n  '.join(detail))
    say(f'{engine} answers. The worker can carry out changes.')
    return 0


# ── Worker ──────────────────────────────────────────────────────────────

def daemon_pid():
    try:
        pid = int(PIDFILE.read_text().strip())
        command = subprocess.run(['ps', '-p', str(pid), '-o', 'command='], capture_output=True, text=True).stdout
        return pid if 'worker.py' in command else None
    except (OSError, ValueError):
        return None


def daemon_stop():
    pid = daemon_pid()
    if not pid:
        return False
    os.kill(pid, signal.SIGTERM)
    for _ in range(300):
        if not daemon_running():
            break
        time.sleep(0.1)
    PIDFILE.unlink(missing_ok=True)
    return True


def daemon_start():
    (ENGINE / 'jobs').mkdir(exist_ok=True)
    with open(LOG, 'a') as log:
        proc = subprocess.Popen([sys.executable, str(ENGINE / 'orchestrator/worker.py')], cwd=ENGINE, stdin=subprocess.DEVNULL,
                                stdout=log, stderr=log, start_new_session=True)
    PIDFILE.write_text(str(proc.pid))
    for _ in range(50):
        if daemon_running():
            return proc.pid
        if proc.poll() is not None:
            break
        time.sleep(0.1)
    raise Problem(f'Worker did not start; see {LOG}')


def cmd_daemon(args):
    if args.action == 'status':
        running = daemon_running()
        say(f'Worker running{" (PID " + str(daemon_pid()) + ")" if daemon_pid() else ""}' if running else 'Worker not running')
        return 0 if running else 1
    if args.action in ('stop', 'restart'):
        if daemon_stop():
            say('Worker stopped')
        elif daemon_running():
            raise Problem('The worker is running but was not started by bin/sayandshape (e.g. systemd). Stop it there.')
        elif args.action == 'stop':
            say('Worker was not running')
    if args.action in ('start', 'restart'):
        if daemon_running():
            say('Worker already running')
            return 0
        load_config()
        say(f'Worker started (PID {daemon_start()}), log: {LOG}')
    return 0


def cmd_service(args):
    user = args.user or getpass.getuser()
    python = shutil.which('python3') or sys.executable
    path = os.environ.get('PATH', '/usr/local/bin:/usr/bin:/bin')
    if sys.platform == 'darwin':
        label = 'sayandshape.daemon'
        target = f'~/Library/LaunchAgents/{label}.plist'
        say(f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{label}</string>
  <key>ProgramArguments</key><array><string>{python}</string><string>{ENGINE}/orchestrator/worker.py</string></array>
  <key>WorkingDirectory</key><string>{ENGINE}</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>{path}</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>Umask</key><integer>2</integer>
  <key>StandardOutPath</key><string>{LOG}</string>
  <key>StandardErrorPath</key><string>{LOG}</string>
</dict>
</plist>""")
        hint = (f'Set up:\n  {ENGINE}/bin/sayandshape service > {target}\n'
                f'  launchctl bootstrap gui/$(id -u) {target}\nStop: launchctl bootout gui/$(id -u)/{label}')
    else:
        target = '/etc/systemd/system/sayandshape-daemon.service'
        say(f"""[Unit]
Description=SayAndShape worker ({ENGINE})
After=network.target

[Service]
Type=simple
User={user}
WorkingDirectory={ENGINE}
ExecStart={python} {ENGINE}/orchestrator/worker.py
Environment=PATH={path}
Restart=on-failure
RestartSec=5
UMask=0002
StandardOutput=append:{LOG}
StandardError=append:{LOG}

[Install]
WantedBy=multi-user.target""")
        hint = (f'Set up:\n  {ENGINE}/bin/sayandshape service --user {user} | sudo tee {target} >/dev/null\n'
                '  sudo systemctl daemon-reload && sudo systemctl enable --now sayandshape-daemon\n'
                f'The user "{user}" needs the AI agent (claude or codex: signed in or with an API key, see bin/sayandshape agent) '
                'and write access to jobs/ and clones/.')
    print('\n' + hint, file=sys.stderr)
    return 0


def cmd_update(args):
    if not (ENGINE / '.git').exists():
        raise Problem('This installation is not a Git checkout; reinstall or replace the files by hand (UPGRADE.md)')
    before = version()
    result = subprocess.run(['git', '-C', str(ENGINE), 'pull', '--ff-only'], env=dict(os.environ, GIT_TERMINAL_PROMPT='0'))
    if result.returncode:
        raise Problem('git pull failed (access to the repository? local changes?)')
    say(f'SayAndShape {before} → {version()}')
    if daemon_pid():
        daemon_stop()
        say(f'Worker restarted (PID {daemon_start()})')
    elif daemon_running():
        say('Restart the worker service now, e.g.: sudo systemctl restart sayandshape-daemon')
    return 0


def main():
    parser = argparse.ArgumentParser(prog='sayandshape', description='Set up and run SayAndShape')
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('init', help='create config and working directories').set_defaults(run=cmd_init)
    sub.add_parser('doctor', help='check prerequisites, configuration and wiring').set_defaults(run=cmd_doctor)
    sub.add_parser('version', help='show the version').set_defaults(run=lambda args: say(version()) or 0)

    add = sub.add_parser('add', help='register a project and wire it to the engine')
    add.add_argument('path', help='folder of the web project (the folder the web server serves)')
    add.add_argument('--id', help='ID (default: derived from the folder name)')
    add.add_argument('--name', help='display name')
    add.add_argument('--url', help='public address of the project, e.g. https://example.org/blog')
    add.add_argument('--server', choices=['apache', 'nginx', 'php', 'auto'], help='web server (auto: apache if .htaccess exists, otherwise php)')
    add.add_argument('--serve', choices=['root', 'prefix'], help='root (default): public variant at the normal address; '
                     'prefix: variants only under /w/<variant>/')
    add.add_argument('--auth', choices=['engine', 'host'], help="engine (default): own login page; host: the app's admin session")
    add.add_argument('--session-name', help="with --auth host: name of the app's session cookie (default: PHP default)")
    add.add_argument('--session-key', help='with --auth host: key in $_SESSION that marks admins (default: admin_logged_in)')
    add.add_argument('--engine-admin', action='store_true', help="with --auth host: the app's admins may also open the setup")
    add.add_argument('--shared', help='comma-separated folders that are not copied per variant (default: detected automatically)')
    add.add_argument('--allowed', help='one sentence: what users may change')
    add.add_argument('--blocked', help='comma-separated protected files/patterns')
    add.add_argument('--public', help='ID of the public variant (default: main)')
    add.add_argument('--force', action='store_true', help='back up and replace an existing custom sayandshape-router.php')
    add.add_argument('--dry-run', action='store_true', help='only show the result, write nothing')
    add.set_defaults(run=cmd_add)

    remove = sub.add_parser('remove', help='unregister a project and remove the wiring')
    remove.add_argument('id')
    remove.add_argument('--purge', action='store_true', help="also delete the project's variants")
    remove.set_defaults(run=cmd_remove)

    listing = sub.add_parser('list', help='list registered projects')
    listing.add_argument('--json', action='store_true')
    listing.set_defaults(run=cmd_list)

    agent = sub.add_parser('agent', help='show AI agents, choose one, store an API key',
                           description='Without options: shows which agents are installed and signed in, and asks for a choice in a terminal.')
    agent.add_argument('--engine', choices=list(AGENTS), help='use this agent')
    auth = agent.add_mutually_exclusive_group()
    auth.add_argument('--api-key-stdin', action='store_true', help='read an API key for the agent from standard input and store it')
    auth.add_argument('--login', action='store_true', help="remove the stored API key; the agent uses the CLI's own sign-in")
    agent.add_argument('--sandbox', choices=['on', 'off'],
                       help='on (default): the agent writes only inside the working copy of a change. '
                            'off: full permissions of the worker user; only inside a container or VM')
    agent.add_argument('--test', action='store_true', help='call the agent once with a one-word request (uses tokens)')
    agent.set_defaults(run=cmd_agent)

    language = sub.add_parser('language', help='show or set the interface language')
    language.add_argument('language', nargs='?', choices=list(LANGUAGES), help='en (English, default) or de (German)')
    language.set_defaults(run=cmd_language)

    passwd = sub.add_parser('passwd', help='set the login password')
    passwd.add_argument('--generate', action='store_true', help='generate a random password and show it once')
    passwd.add_argument('--stdin', action='store_true', help='read the password from standard input')
    passwd.set_defaults(run=cmd_passwd)

    check = sub.add_parser('check', help='test a running site over HTTP')
    check.add_argument('id')
    check.add_argument('--url', help='address of the project (default: app_url from the configuration)')
    check.set_defaults(run=cmd_check)

    daemon = sub.add_parser('daemon', help='start/stop the worker')
    daemon.add_argument('action', choices=['start', 'stop', 'restart', 'status'])
    daemon.set_defaults(run=cmd_daemon)

    service = sub.add_parser('service', help='print a systemd unit or launchd plist')
    service.add_argument('--user', help='user the worker runs as (default: current user)')
    service.set_defaults(run=cmd_service)

    sub.add_parser('update', help='update the engine').set_defaults(run=cmd_update)

    args = parser.parse_args()
    try:
        return args.run(args)
    except Problem as exc:
        print(f'Error: {exc}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())

# The engine is not a web directory. It should live outside every document root; this file only
# limits the damage if it does not (Apache). Projects reach the engine through their sayandshape-router.php.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
